---
interface Props {
  imageSrc?: string;
  imageAlt?: string;
}

const {
  imageSrc = '/fb/hero-cover.jpg',
  imageAlt = "Pillole Ciclistiche — DB3K",
} = Astro.props;
---

<section class="hero-ducati">
  <div class="hero-media hero-anim">
    <img src={imageSrc} alt={imageAlt} width="1080" height="1436" fetchpriority="high" />
    <div class="hero-overlay"></div>
    <div class="hero-red-accent"></div>
  </div>

  <div class="hero-container">
    <div class="hero-badges">
      <span class="badge badge-red">DB3K · GUIDA RAPIDA</span>
      <span class="badge">NUTRIZIONE · ALLENAMENTO · ATTREZZATURA</span>
    </div>

    <h1 class="hero-title">
      Pillole<span class="accent">.</span>
    </h1>

    <p class="hero-manifesto">
      Piccole guide per grandi pedalate. Nutrizione, allenamento, attrezzatura, sicurezza e tecnica: 
      tutto ciò che ti serve, in pochi minuti.
    </p>

    <div class="hero-actions">
      <a href="#pillole" class="btn btn-primary">Scopri le pillole ↓</a>
      <a href="/" class="btn btn-secondary">
        Torna al diario <span aria-hidden="true">↩</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-ducati {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: flex-end;
    background-color: var(--bg-asphalt, #0A0A0B);
    color: var(--text-white, #F8F8F8);
    overflow: hidden;
    border-bottom: 3px solid var(--ducati-red, #CC0000);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    filter: contrast(1.08) saturate(0.95);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 10, 11, 0.45) 0%,
      rgba(10, 10, 11, 0.78) 55%,
      rgba(10, 10, 11, 0.98) 100%
    );
  }

  .hero-red-accent {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 85% 20%,
      rgba(204, 0, 0, 0.28) 0%,
      transparent 55%
    );
    pointer-events: none;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 4rem 1.5rem 2.5rem;
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .badge {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.32rem 0.65rem;
    background: rgba(20, 20, 22, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: var(--text-silver, #A1A1AA);
    border-radius: 2px;
  }

  .badge-red {
    background: var(--ducati-red, #CC0000);
    border-color: var(--ducati-red, #CC0000);
    color: #FFFFFF;
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.04em;
    font-style: italic;
    margin: 0 0 1.25rem;
    text-transform: uppercase;
  }

  .hero-title .accent {
    color: var(--ducati-red, #CC0000);
    text-shadow: 0 0 28px rgba(204, 0, 0, 0.45);
  }

  .hero-manifesto {
    max-width: 58ch;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.6;
    color: #E4E4E7;
    margin: 0 0 2rem;
  }

  .hero-manifesto strong {
    color: #FFFFFF;
    font-weight: 700;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.75rem 1.3rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }

  .btn-primary {
    background-color: var(--ducati-red, #CC0000);
    color: #FFFFFF;
    border: 1px solid var(--ducati-red, #CC0000);
    box-shadow: 0 6px 20px rgba(204, 0, 0, 0.35);
  }

  .btn-primary:hover {
    background-color: var(--ducati-red-dark, #990000);
    border-color: var(--ducati-red-dark, #990000);
    transform: translateY(-1px);
  }

  .btn-secondary {
    background-color: rgba(20, 20, 22, 0.75);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(6px);
  }

  .btn-secondary:hover {
    border-color: var(--ducati-red, #CC0000);
    background-color: rgba(204, 0, 0, 0.12);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-media img {
      animation: none;
    }
  }
</style>
