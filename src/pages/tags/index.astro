---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

/* Facet cloud → /tags (conteggio per tag, ordine alfabetico) */
const collection = await getCollection('posts');
const posts = Array.isArray(collection) ? collection : [...collection];

const counts = new Map();
for (const entry of posts) {
  for (const tag of entry.data.tags ?? []) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}

const tags = [...counts.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<Layout title="DB3K — Tags" description="Elenco completo dei tag del diario DB3K: album, allenamenti, gare e altro.">
  <section class="mx-auto w-full max-w-2xl px-4 sm:px-6 lg:mx-auto py-16">
    <header class="mb-8 flex items-end justify-between gap-4">
      <h1 class="text-3xl font-black italic tracking-tight text-ink sm:text-4xl">Tag<span class="text-ducati">.</span></h1>
    </header>

    {tags.length === 0 ? (
      <p class="text-silver">Nessun tag per ora.</p>
    ) : (
      <div class="grid gap-2">
        {tags.map(([tag, count]) => (
          <a href={`/tags/${tag}`} class="group flex items-center justify-between rounded-full border border-lunar bg-surface-elev px-4 py-3 transition hover:border-ducati/60">
            <span class="text-sm font-semibold tracking-wide text-ink transition group-hover:text-ducati"># {tag}</span>
            <span class="shrink-0 rounded-full border border-lunar bg-surface px-3 py-1.5 text-[11px] font-bold tabular-nums tracking-widest text-silver">{count} post</span>
          </a>
        ))}
      </div>
    )}

    <nav class="mt-16 flex items-center justify-between border-t border-lunar pt-6 text-sm text-silver">
      <a href="/" class="font-semibold tracking-wide text-ink transition hover:text-ducati">← Tutti gli articoli</a>
      <span class="text-[11px] font-bold tracking-widest">DB<span class="text-ducati">3K</span></span>
    </nav>
  </section>
</Layout>
