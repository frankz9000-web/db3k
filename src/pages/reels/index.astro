---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

/* Reel — video brevi dalla pagina Facebook DB3K */
const collection = await getCollection('posts');
const posts = Array.isArray(collection) ? collection : [...collection];
const reelPosts = posts.filter((p) => (p.data.tags ?? []).some((t) => t === 'reel'))
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

/* Fonti reali dei reel — una per slug, sotto public/fb/ */
const MEDIA: Record<string, string> = {
  'ritmo-gara': '/fb/ritmo-gara/video.mp4',
  'ancora-ritmo-gara': '/fb/ancora-ritmo-gara/video.mp4',
  'video-whatsapp-25-ottobre': '/fb/video-whatsapp-25-ottobre/video.mp4',

};

function dateLabel(d: Date): string {
  return new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
}
---

<Layout title="DB3K — Reel" description="Reel e video brevi DB3K dalle gare, allenamenti e uscite.">
  <section class="mx-auto w-full max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-8 flex items-end justify-between gap-4">
      <h1 class="text-3xl font-black italic tracking-tight text-ink sm:text-4xl">Reel<span class="text-ducati">.</span></h1>
      <span class="shrink-0 rounded-full border border-lunar bg-surface-elev px-3.5 py-1.5 text-[11px] font-bold tracking-widest text-silver">{reelPosts.length} VIDEO</span>
    </header>

    {reelPosts.length === 0 ? (
      <p class="text-silver">Nessun reel per ora.</p>
    ) : (
      <div class="grid gap-4 sm:gap-5">
        {reelPosts.map((post) => (
          <a href={`/posts/${post.id}`} class="group flex items-center gap-3 rounded-full border border-lunar bg-surface-elev py-2 pl-2 pr-4 transition hover:border-ducati/60">
            <span class="preview-anim block h-11 w-11 shrink-0 overflow-hidden rounded-md border border-lunar bg-surface">
              {post.data.image
                ? <img src={post.data.image} alt="" loading="lazy" class="kb-img" />
                : <span class="flex h-full w-full items-center justify-center text-[9px] font-black italic text-white/25">DB<b class="text-ducati/80">3K</b></span>}
            </span>
            <span class="min-w-0 flex-1 truncate text-sm font-semibold tracking-wide text-ink transition group-hover:text-ducati">{post.data.title}</span>
            <time datetime={new Date(post.data.pubDate).toISOString()} class="shrink-0 text-[11px] tabular-nums text-silver">
              {dateLabel(new Date(post.data.pubDate))}
            </time>
          </a>
        ))}
      </div>
    )}

    <nav class="mt-16 flex items-center justify-between border-t border-lunar pt-6 text-sm text-silver">
      <a href="/" class="font-semibold tracking-wide text-ink transition hover:text-ducati">← Tutti gli articoli</a>
      <span class="text-[11px] font-bold tracking-widest">DB<span class="text-ducati">3K</span></span>
    </nav>
  </section>
</Layout>
