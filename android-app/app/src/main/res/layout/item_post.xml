<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margin_card"
    android:layout_marginVertical="@dimen/spacing_sm"
    app:cardBackgroundColor="@color/ducati_dark_gray"
    app:cardCornerRadius="@dimen/corner_radius_md"
    app:cardElevation="@dimen/elevation_card"
    app:strokeColor="@color/border_color"
    app:strokeWidth="1dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/padding_card">

        <!-- Cover Image -->
        <ImageView
            android:id="@+id/cover_image"
            android:layout_width="@dimen/image_thumbnail"
            android:layout_height="@dimen/image_thumbnail"
            android:scaleType="centerCrop"
            android:src="@color/ducati_medium_gray"
            android:contentDescription="Copertina post"
            android:layout_marginEnd="@dimen/spacing_md" />

        <!-- Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Title -->
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textWeight="600"
                android:textColor="@color/text_primary"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Excerpt -->
            <TextView
                android:id="@+id/excerpt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="@dimen/spacing_xxs" />

            <!-- Meta Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/spacing_sm">

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_tertiary" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:background="@color/divider_color"
                    android:layout_marginHorizontal="@dimen/spacing_sm"
                    android:alpha="0.5" />

                <TextView
                    android:id="@+id/category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/ducati_red"
                    android:textWeight="500" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:background="@color/divider_color"
                    android:layout_marginHorizontal="@dimen/spacing_sm"
                    android:alpha="0.5" />

                <TextView
                    android:id="@+id/author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_tertiary" />

            </LinearLayout>

            <!-- Tags -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/tags_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:chipSpacing="@dimen/spacing_xs" />

            <!-- Read Indicator -->
            <View
                android:id="@+id/read_indicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@color/status_online"
                android:alpha="0"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>