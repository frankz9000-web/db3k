<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ducati_black"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/spacing_xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/margin_screen"
        android:paddingTop="@dimen/spacing_md">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:gravity="center">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_launcher_foreground"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    style="@style/TextAppearance.DB3K.HeadlineSmall"
                    android:layout_marginTop="@dimen/spacing_md" />

                <TextView
                    android:id="@+id/version_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_version"
                    style="@style/TextAppearance.DB3K.BodySmall"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginTop="@dimen/spacing_xs" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/powered_by_ducati"
                    style="@style/TextAppearance.DB3K.LabelSmall"
                    android:textColor="@color/ducati_red"
                    android:layout_marginTop="@dimen/spacing_xs" />

            </LinearLayout>

            <!-- Ducati accent line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@drawable/divider_ducati"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <!-- Notifications Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_notifications"
                style="@style/TextAppearance.DB3K.TitleMedium"
                android:textColor="@color/ducati_red"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- Master Switch Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.DB3K.CardView"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/padding_card"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_push_enabled"
                            style="@style/TextAppearance.DB3K.TitleSmall" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_push_enabled_desc"
                            style="@style/TextAppearance.DB3K.BodySmall"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="@dimen/spacing_xxs" />

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_push_enabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Widget.DB3K.CompoundButton.Switch" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Category Switches Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/push_categories_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.DB3K.CardView"
                android:layout_marginBottom="@dimen/spacing_md"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_card">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tipologie di notifiche"
                            style="@style/TextAppearance.DB3K.LabelMedium"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="@dimen/spacing_md" />

                        <!-- New Posts -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="@dimen/spacing_sm">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_new_posts"
                                    style="@style/TextAppearance.DB3K.TitleSmall" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Nuovi articoli sul blog"
                                    style="@style/TextAppearance.DB3K.BodySmall"
                                    android:textColor="@color/text_secondary" />

                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switch_new_posts"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/Widget.DB3K.CompoundButton.Switch" />

                        </LinearLayout>

                        <!-- Race Results -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="@dimen/spacing_sm">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_race_results"
                                    style="@style/TextAppearance.DB3K.TitleSmall" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Risultati e classifiche gare"
                                    style="@style/TextAppearance.DB3K.BodySmall"
                                    android:textColor="@color/text_secondary" />

                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switch_race_results"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/Widget.DB3K.CompoundButton.Switch" />

                        </LinearLayout>

                        <!-- Events -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_events"
                                    style="@style/TextAppearance.DB3K.TitleSmall" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Eventi e uscite in programma"
                                    style="@style/TextAppearance.DB3K.BodySmall"
                                    android:textColor="@color/text_secondary" />

                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switch_events"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/Widget.DB3K.CompoundButton.Switch" />

                        </LinearLayout>

                    </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Sound & Vibration Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/push_sound_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.DB3K.CardView"
                android:layout_marginBottom="@dimen/spacing_md"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/padding_card">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_sound"
                            style="@style/TextAppearance.DB3K.TitleSmall" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Suono per le notifiche push"
                            style="@style/TextAppearance.DB3K.BodySmall"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_sound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Widget.DB3K.CompoundButton.Switch" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/push_vibration_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.DB3K.CardView"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/padding_card">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_vibration"
                            style="@style/TextAppearance.DB3K.TitleSmall" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vibrazione per le notifiche push"
                            style="@style/TextAppearance.DB3K.BodySmall"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_vibration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Widget.DB3K.CompoundButton.Switch" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- About Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_about"
                style="@style/TextAppearance.DB3K.TitleMedium"
                android:textColor="@color/ducati_red"
                android:layout_marginBottom="@dimen/spacing_md" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.DB3K.CardView"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_card">

                    <TextView
                        android:id="@+id/privacy_policy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_privacy"
                        style="@style/TextAppearance.DB3K.BodyMedium"
                        android:textColor="@color/ducati_red"
                        android:paddingVertical="@dimen/spacing_sm"
                        android:drawableEnd="@drawable/ic_arrow_right"
                        android:drawablePadding="@dimen/spacing_sm" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/divider_ducati" />

                    <TextView
                        android:id="@+id/terms_of_service"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_terms"
                        style="@style/TextAppearance.DB3K.BodyMedium"
                        android:textColor="@color/ducati_red"
                        android:paddingVertical="@dimen/spacing_sm"
                        android:drawableEnd="@drawable/ic_arrow_right"
                        android:drawablePadding="@dimen/spacing_sm" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/divider_ducati" />

                    <TextView
                        android:id="@+id/github_repo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_github"
                        style="@style/TextAppearance.DB3K.BodyMedium"
                        android:textColor="@color/ducati_red"
                        android:paddingVertical="@dimen/spacing_sm"
                        android:drawableEnd="@drawable/ic_arrow_right"
                        android:drawablePadding="@dimen/spacing_sm" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/divider_ducati" />

                    <TextView
                        android:id="@+id/send_feedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_feedback"
                        style="@style/TextAppearance.DB3K.BodyMedium"
                        android:textColor="@color/ducati_red"
                        android:paddingVertical="@dimen/spacing_sm"
                        android:drawableEnd="@drawable/ic_arrow_right"
                        android:drawablePadding="@dimen/spacing_sm" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>