<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background color -->
    <item android:drawable="@color/ducati_black" />
    
    <!-- Subtle pattern overlay -->
    <item>
        <bitmap
            android:src="@drawable/pattern_carbon"
            android:gravity="fill"
            android:alpha="0.05" />
    </item>
    
    <!-- Centered Logo -->
    <item
        android:width="120dp"
        android:height="120dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
    
    <!-- Bottom tagline -->
    <item android:gravity="bottom|center_horizontal" android:bottom="60dp">
        <vector
            android:width="200dp"
            android:height="24dp"
            android:viewportWidth="200"
            android:viewportHeight="24">
            <path
                android:fillColor="#E31837"
                android:pathData="M0,0h200v24H0z" />
        </vector>
    </item>
</layer-list>