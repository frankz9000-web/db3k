<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Carbon fiber pattern -->
    <item>
        <bitmap
            android:src="@drawable/pattern_carbon"
            android:gravity="fill"
            android:alpha="0.1" />
    </item>
    <!-- Surface color -->
    <item android:drawable="@color/ducati_dark_gray" />
    <!-- Top accent line -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/ducati_red" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Red top border accent -->
    <item android:top="0dp" android:left="12dp" android:right="12dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ducati_red" />
            <corners android:topLeftRadius="12dp" android:topRightRadius="12dp" />
        </shape>
    </item>
    <!-- Mask to keep only top border -->
    <item android:top="2dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ducati_dark_gray" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>